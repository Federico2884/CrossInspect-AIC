APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- CrossInspect AI service ---
AI_SERVICE_URL=http://ai:8000
AI_PORT=8001
# Timeout HTTP client Laravel saat memanggil service AI, dalam detik. Default
# Laravel 30 detik jauh terlalu pendek: satu halaman padat dengan engine asli
# terukur ~300 detik, sedangkan engine mock menjawab dalam milidetik.
AI_HTTP_TIMEOUT=600
# Dockerfile        = slim (mock / rendering only)
# Dockerfile.ml     = + torch/transformers CPU (Qwen2-VL)
AI_DOCKERFILE=Dockerfile
AI_OMP_NUM_THREADS=4
# Modul 2 — Physical Inspection.
# auto = YOLO bila image punya torch (Dockerfile.ml), selain itu mock.
# Deteksi kardus yang sesungguhnya butuh AI_DOCKERFILE=Dockerfile.ml.
AI_VISION_ENGINE=auto
AI_VISION_CONF_THRESHOLD=0.40

# Engine parsing dokumen:
#   mock     = fixture deterministik, jalan di image slim, jawab dalam milidetik
#   qwen2vl  = Qwen2-VL-2B asli; WAJIB AI_DOCKERFILE=Dockerfile.ml
# Default mock supaya klien Laravel tidak terpaksa menunggu inference CPU.
AI_ENGINE=mock
# Batas piksel yang dilihat model. Menurunkannya ternyata hampir tidak
# menghemat waktu tetapi bisa menghilangkan baris barang — lihat tabel
# pengukuran di ai/README.md sebelum mengubahnya.
# AI_QWEN_MAX_PIXELS=1003520

WWWUSER=1000
WWWGROUP=1000