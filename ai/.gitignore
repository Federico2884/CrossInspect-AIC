__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.env

# Cache HF & bobot besar — jangan pernah di-commit.
# Perkecualian: bobot YOLO Modul 2 (~5 MB) sengaja di-commit supaya repo
# self-contained — juri tidak perlu API key Roboflow maupun langkah download.
# Qwen2-VL tetap di luar: ia turun ke .cache/huggingface, bukan ke models/.
.cache/
models/*
!models/*.pt
*.safetensors
*.bin

# Dataset sintetis & output eval — TIDAK pernah di-commit.
# Seed-nya yang jadi sumber kebenaran: `--seed 42` menghasilkan dataset yang
# identik, jadi meng-commit 50 MB JPEG tidak menambah informasi apa pun.
data/
outputs/

# Cache Augraphy (dibuat otomatis saat generate dataset)
augraphy_cache/
